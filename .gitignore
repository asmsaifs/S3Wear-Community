# --- OS / editors ---
.DS_Store
._*
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.cache/
.clangd/
compile_commands.json

# --- Host / simulator / generic CMake builds ---
/build/
cmake-build-*/
*.png.tmp

# --- ESP-IDF firmware ---
firmware/build/
firmware/build-*/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock.bak
firmware/**/__pycache__/
*.elf
*.map
*.bin
!protocol/testvectors/**/*.bin

# --- Mini app SDK / apps ---
apps/*/build/
store/apps/*/build/
sdk/templates/*/build/
*.wasm
# Hand-assembled runtime test modules (gen_test_apps.py), embedded in the firmware.
!firmware/components/app_runtime/test_apps/*.wasm
# Package test fixture (test_apps/pkg/make.sh packs it); host tests read it.
!firmware/components/app_runtime/test_apps/pkg/hello/app.wasm
# The preinstalled apps' modules (apps/build.sh), embedded in the firmware.
!apps/*/app.wasm
# The SDK samples' modules (sdk/examples/build.sh), embedded in the firmware and run by snapshot tests.
!sdk/examples/*/*.wasm
*.s3wapp

# --- Android ---
android/**/.gradle/
android/build/
android/**/build/
android/local.properties
android/.kotlin/
android/captures/
android/**/*.iml
*.apk
*.aab
*.jks
*.keystore

# --- Python tooling ---
__pycache__/
*.pyc
.venv/
venv/

# --- Secrets (signing keys never go in the repo) ---
*.pem
*.key
secrets/
.env

# --- Cloudflare wrangler local state ---
.wrangler/
.claude/
